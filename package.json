{
  "name": "radioserver",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js controller for SHOUTcast DNAS and Liquidsoap AutoDJ",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "server.js",
  "scripts": {
    "install": "node server.js install --accept-license",
    "update": "node server.js update --accept-license",
    "code:update": "node server.js update_code",
    "install:linux": "node app/platform-runner.js linux server install --accept-license",
    "install:windows": "node app/platform-runner.js windows server install --accept-license",
    "install:windows:x86": "node app/platform-runner.js windows-x86 server install --accept-license",
    "install:macos": "node app/platform-runner.js macos server install --accept-license",
    "install:freebsd": "node app/platform-runner.js freebsd server install --accept-license",
    "update:linux": "node app/platform-runner.js linux server update --accept-license",
    "update:windows": "node app/platform-runner.js windows server update --accept-license",
    "update:windows:x86": "node app/platform-runner.js windows-x86 server update --accept-license",
    "update:macos": "node app/platform-runner.js macos server update --accept-license",
    "update:freebsd": "node app/platform-runner.js freebsd server update --accept-license",
    "start": "node server.js start",
    "start:linux": "node app/platform-runner.js linux server start",
    "start:windows": "node app/platform-runner.js windows server start",
    "start:windows:x86": "node app/platform-runner.js windows-x86 server start",
    "start:macos": "node app/platform-runner.js macos server start",
    "start:freebsd": "node app/platform-runner.js freebsd server start",
    "stop": "node server.js stop",
    "restart": "node server.js restart",
    "status": "node server.js status",
    "console": "node server.js console",
    "logs:clear": "node server.js clear_logs",
    "setup": "node server.js setup",
    "doctor": "node server.js doctor",
    "test": "node --test",
    "playlist": "node server.js playlist",
    "autodj:start": "node autodj.js start",
    "autodj:start:linux": "node app/platform-runner.js linux autodj start",
    "autodj:start:windows": "node app/platform-runner.js windows autodj start",
    "autodj:start:macos": "node app/platform-runner.js macos autodj start",
    "autodj:start:freebsd": "node app/platform-runner.js freebsd autodj start",
    "autodj:stop": "node autodj.js stop",
    "autodj:restart": "node autodj.js restart",
    "autodj:status": "node autodj.js status",
    "autodj:console": "node autodj.js console",
    "autodj:logs:clear": "node autodj.js clear_logs"
  }
}
